# Leave blank when the frontend is served by the backend or a reverse proxy.
# Set this only when the API is hosted on a different origin,
# e.g. https://your-api.up.railway.app/api
VITE_API_BASE=

# Supabase project credentials, from Project Settings -> API keys.
# Both are safe to ship in the browser bundle: the publishable key only grants
# what the row-level security policies in supabase/schema.sql allow.
# Leave both blank to run the app in guest-only mode with no accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
