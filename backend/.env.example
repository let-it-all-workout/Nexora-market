PORT=4000
NODE_ENV=development

# Required for live Nigerian Exchange data.
NGX_PULSE_API_KEY=

# Comma-separated browser origins allowed to call this API.
# Single-service deploy (API serves the built frontend): leave blank.
# Split deploy: list the frontend origin, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
# Only used to narrow the connect-src content-security-policy directive.
SUPABASE_URL=

# Set to 0 to stop the background provider pre-fetch loop. Leave unset to keep
# charts warm; turn it off if you are close to a provider's quota.
WARM_CACHE=1
